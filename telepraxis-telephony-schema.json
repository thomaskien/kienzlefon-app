      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "RoutingRequest": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/UUID"
        },
        "client_id": {
          "$ref": "#/$defs/ClientId"
        },
        "extension": {
          "$ref": "#/$defs/ExtensionId"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "member": {
          "type": "boolean"
        },
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "pbx_epoch": {
          "$ref": "#/$defs/UUID"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "state": {
          "enum": [
            "accepted",
            "applying",
            "applied",
            "rejected",
            "unknown",
            "expired"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "applied_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "changed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request_id",
        "client_id",
        "extension",
        "route",
        "member",
        "expected_revision",
        "pbx_epoch",
        "expires_at",
        "state",
        "created_at",
        "updated_at",
        "applied_at",
        "result_revision",
        "changed",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "applied"
              }
            }
          },
          "then": {
            "properties": {
              "applied_at": {
                "$ref": "#/$defs/Timestamp"
              },
              "result_revision": {
                "$ref": "#/$defs/Revision"
              },
              "changed": {
                "type": "boolean"
              },
              "error": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "applied_at": {
                "type": "null"
              },
              "result_revision": {
                "type": "null"
              },
              "changed": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "rejected",
                  "expired",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/Error"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "CommandResponse": {
      "type": "object",
      "properties": {
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoutingRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request",
        "error"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "request": {
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "error": {
              "type": "object"
            }
          }
        }
      ]
    },
    "AppClient": {
      "type": "object",
      "properties": {
