        "csrf_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AppClient"
          },
          "maxItems": 1000
        }
