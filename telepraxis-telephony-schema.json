            "properties": {
              "id": {
                "$ref": "#/$defs/ClientId"
              },
              "token_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "allowed_clients": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ClientId"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "token_sha256",
              "allowed_clients"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "identities"
      ],
      "additionalProperties": false
    }
