{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kienzlefon:telephony:1",
  "title": "Kienzlefon Telefonievertrag 1.0.2",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "PbxId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "ClientId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "ExtensionId": {
      "type": "string",
      "pattern": "^[0-9]{1,12}$"
    },
    "Revision": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^r1:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:[1-9][0-9]{0,18}$"
    },
    "Route": {
      "enum": [
        "normal",
        "specialist"
      ]
    },
    "Permission": {
      "type": "object",
      "properties": {
        "can_enable": {
          "type": "boolean"
        },
        "can_disable": {
          "type": "boolean"
        },
        "enable_reason": {
          "anyOf": [
            {
              "enum": [
                "not_supported",
                "state_unknown",
                "route_unavailable",
                "global_disabled",
                "not_eligible",
                "admin_locked",
                "last_member"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "disable_reason": {
          "anyOf": [
            {
              "enum": [
                "not_supported",
                "state_unknown",
                "route_unavailable",
                "global_disabled",
                "not_eligible",
                "admin_locked",
                "last_member"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "can_enable",
        "can_disable",
        "enable_reason",
        "disable_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "can_enable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "enable_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "enable_reason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "can_disable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "disable_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "disable_reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "Routing": {
      "type": "object",
      "properties": {
        "normal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "specialist": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "type": "object",
          "properties": {
            "normal": {
              "$ref": "#/$defs/Permission"
            },
            "specialist": {
              "$ref": "#/$defs/Permission"
            }
          },
          "required": [
            "normal",
            "specialist"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "normal",
        "specialist",
        "permissions"
      ],
      "additionalProperties": false
    },
    "Group": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Route"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ivr_digit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "ivr_digit",
        "available"
      ],
      "additionalProperties": false
    },
    "RoutingControl": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "available": {
          "type": "boolean"
        },
        "pbx_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_age_ms": {
          "const": 10000
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "not_supported",
                "not_configured",
                "state_unknown",
                "source_disconnected",
                "synchronizing",
                "source_incomplete",
                "stale",
                "applying"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "supported",
        "enabled",
        "available",
        "pbx_epoch",
        "revision",
        "as_of",
        "age_ms",
        "max_age_ms",
        "reason_code",
        "groups"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "supported": {
                "const": true
              },
              "enabled": {
                "type": "boolean"
              },
              "pbx_epoch": {
                "$ref": "#/$defs/UUID"
              },
              "revision": {
                "$ref": "#/$defs/Revision"
              },
              "as_of": {
                "$ref": "#/$defs/Timestamp"
              },
              "age_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "type": "null"
              },
              "as_of": {
                "type": "null"
              },
              "age_ms": {
                "type": "null"
              },
              "reason_code": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "LiveCounters": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "current",
            "unavailable"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "not_supported",
                "not_configured",
                "source_disconnected",
                "synchronizing",
                "source_incomplete",
                "stale"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "pbx_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_age_ms": {
          "const": 10000
        },
        "waiting": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "ivr": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "ai": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reason_code",
        "pbx_epoch",
        "as_of",
        "age_ms",
        "max_age_ms",
        "waiting",
        "ivr",
        "ai"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "current"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "type": "null"
              },
              "as_of": {
                "$ref": "#/$defs/Timestamp"
              },
              "age_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "pbx_epoch": {
                "$ref": "#/$defs/UUID"
              },
              "waiting": {
                "type": "integer",
                "minimum": 0
              },
              "ivr": {
                "type": "integer",
                "minimum": 0
              },
              "ai": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "reason_code": {
                "type": "string"
              },
              "as_of": {
                "type": "null"
              },
              "age_ms": {
                "type": "null"
              },
              "waiting": {
                "type": "null"
              },
              "ivr": {
                "type": "null"
              },
              "ai": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Extension": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ExtensionId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "enum": [
            "idle",
            "ringing",
            "busy",
            "offline",
            "unknown"
          ]
        },
        "state_as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "routing": {
          "$ref": "#/$defs/Routing"
        }
      },
      "required": [
        "id",
        "label",
        "state",
        "state_as_of",
        "state_age_ms",
        "routing"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "then": {
            "properties": {
              "state_as_of": {
                "$ref": "#/$defs/Timestamp"
              },
              "state_age_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              }
            }
          }
        }
      ]
    },
    "ControlExtension": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ExtensionId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "routing": {
          "$ref": "#/$defs/Routing"
        }
      },
      "required": [
        "id",
        "label",
        "routing"
      ],
      "additionalProperties": false
    },
    "StatisticsRoute": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "ivr",
            "ai",
            "queue",
            "prescription",
            "referral",
            "appointment",
            "callback",
            "other",
            "opening_hours",
            "pharmacy",
            "specialist"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "incoming_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "label",
        "incoming_calls"
      ],
      "additionalProperties": false
    },
    "Today": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "const": "Europe/Berlin"
        },
        "period_start": {
          "$ref": "#/$defs/Timestamp"
        },
        "period_end": {
          "$ref": "#/$defs/Timestamp"
        },
        "incoming_calls": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "not_configured",
                "storage_unavailable",
                "initial_partial_day",
                "capture_gap"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "routes": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StatisticsRoute"
              },
              "minItems": 11,
              "maxItems": 11
            },
            {
              "type": "null"
            }
          ]
        },
        "unclassified_calls": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "date",
        "timezone",
        "period_start",
        "period_end",
        "incoming_calls",
        "status",
        "as_of",
        "reason_code",
        "routes",
        "unclassified_calls"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "incoming_calls": {
                "type": "null"
              },
              "routes": {
                "type": "null"
              },
              "unclassified_calls": {
                "type": "null"
              },
              "as_of": {
                "type": "null"
              },
              "reason_code": {
                "enum": [
                  "not_configured",
                  "storage_unavailable"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "incoming_calls": {
                "type": "integer",
                "minimum": 0
              },
              "routes": {
                "type": "array"
              },
              "unclassified_calls": {
                "type": "integer",
                "minimum": 0
              },
              "as_of": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "initial_partial_day",
                  "capture_gap"
                ]
              }
            }
          }
        }
      ]
    },
    "Statistics": {
      "type": "object",
      "properties": {
        "today": {
          "$ref": "#/$defs/Today"
        }
      },
      "required": [
        "today"
      ],
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "live_counters": {
          "type": "boolean"
        },
        "routing_control": {
          "type": "boolean"
        },
        "call_statistics": {
          "type": "boolean"
        }
      },
      "required": [
        "live_counters",
        "routing_control",
        "call_statistics"
      ],
      "additionalProperties": false
    },
    "Overview": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "source": {
          "enum": [
            "live",
            "demo"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "live_counters": {
          "$ref": "#/$defs/LiveCounters"
        },
        "routing_control": {
          "$ref": "#/$defs/RoutingControl"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Extension"
          },
          "maxItems": 1000
        },
        "call_statistics": {
          "$ref": "#/$defs/Statistics"
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "source",
        "capabilities",
        "live_counters",
        "routing_control",
        "extensions",
        "call_statistics"
      ],
      "additionalProperties": false
    },
    "ControlCapabilities": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "pbx_id": {
          "$ref": "#/$defs/PbxId"
        },
        "features": {
          "type": "object",
          "properties": {
            "live_counters": {
              "type": "boolean"
            },
            "routing_control": {
              "type": "boolean"
            },
            "statistics_events": {
              "type": "boolean"
            }
          },
          "required": [
            "live_counters",
            "routing_control",
            "statistics_events"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "command_ttl_seconds": {
              "const": 30
            },
            "max_body_bytes": {
              "const": 8192
            },
            "max_age_ms": {
              "const": 10000
            },
            "request_retention_seconds": {
              "const": 604800
            }
          },
          "required": [
            "command_ttl_seconds",
            "max_body_bytes",
            "max_age_ms",
            "request_retention_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "pbx_id",
        "features",
        "limits"
      ],
      "additionalProperties": false
    },
    "ControlState": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "pbx_id": {
          "$ref": "#/$defs/PbxId"
        },
        "pbx_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "live_counters": {
          "$ref": "#/$defs/LiveCounters"
        },
        "routing_control": {
          "$ref": "#/$defs/RoutingControl"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlExtension"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "schema_version",
        "pbx_id",
        "pbx_epoch",
        "generated_at",
        "live_counters",
        "routing_control",
        "extensions"
      ],
      "additionalProperties": false
    },
    "RoutingCommand": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/UUID"
        },
        "client_id": {
          "$ref": "#/$defs/ClientId"
        },
        "extension": {
          "$ref": "#/$defs/ExtensionId"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "member": {
          "type": "boolean"
        },
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "pbx_epoch": {
          "$ref": "#/$defs/UUID"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "request_id",
        "client_id",
        "extension",
        "route",
        "member",
        "expected_revision",
        "pbx_epoch",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unknown_extension",
            "unknown_route",
            "unknown_client",
            "unauthenticated",
            "forbidden_origin",
            "forbidden_network",
            "csrf_failed",
            "client_forbidden",
            "global_disabled",
            "admin_locked",
            "not_eligible",
            "request_not_found",
            "not_found",
            "method_not_allowed",
            "payload_too_large",
            "json_required",
            "revision_conflict",
            "pbx_restarted",
            "request_id_conflict",
            "last_member",
            "state_unknown",
            "request_expired",
            "route_unavailable",
            "not_supported",
            "upstream_unreachable",
            "upstream_authentication_failed",
            "state_unavailable",
            "apply_failed",
            "upstream_timeout"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "current_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_pbx_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "current_revision",
        "current_pbx_epoch"
