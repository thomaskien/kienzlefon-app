        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/ExtensionId"
              },
              "normal": {
                "$ref": "#/$defs/PolicyMember"
              },
              "specialist": {
                "$ref": "#/$defs/PolicyMember"
              }
            },
            "required": [
              "id",
              "normal",
              "specialist"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
