        "clients"
      ],
      "additionalProperties": false
    },
    "PolicyMember": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "default_member": {
          "type": "boolean"
        },
        "can_enable": {
          "type": "boolean"
        },
        "can_disable": {
          "type": "boolean"
        },
        "penalty": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "eligible",
        "default_member",
        "can_enable",
        "can_disable",
        "penalty"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "default_member": {
                "const": false
              },
              "can_enable": {
                "const": false
              },
              "can_disable": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "penalty": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "RoutingPolicy": {
      "type": "object",
      "properties": {
        "remote_enabled": {
          "type": "boolean"
